{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squirrelapi-web",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "main": "worker/index.ts",
  "vars": {
    "SUPABASE_URL": "https://lnwifbsjfwchshtxyzcu.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_qnVqGW26QAL1MALnz0xu7w_Sz9sc1nU"
  },
  "routes": [{ "pattern": "squirrelapi.org", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
