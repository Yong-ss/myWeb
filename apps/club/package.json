{
  "name": "@squirrelapi/club",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "build": "next build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8788 --local-protocol https",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy:production": "wrangler deploy",
    "test": "node --test worker/auth.test.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
