{
  "name": "@squirrelapi/club",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "build": "next build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8788 --local-protocol https",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy:production": "wrangler deploy",
    "test": "node --test worker/*.test.mjs \"src/**/*.test.mjs\""
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lottie-web": "5.13.0",
    "motion": "14.7.1",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
